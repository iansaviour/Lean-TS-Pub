#include "imports/stdlib.fc";
#include "imports/survey_common.fc";

;; -----------------------------------------
;; iansaviour
;; Survey: one contract per survey, deployed by the SurveyDApp master.
;; Choice questions are tallied (votes per option); every response is also
;; stored in full so text answers can be read back.
;; Storage layout: see imports/survey_common.fc
;;
;; Submit body:
;;   op ^answers   answers = HashmapE 8 ^Answer, one entry per question
;; -----------------------------------------

(slice, int, slice, int, int, int, int, int, cell, cell, cell) load_data() inline {
    var ds = get_data().begin_parse();
    return (
        ds~load_msg_addr(), ;; master
        ds~load_uint(32),   ;; survey_id
        ds~load_msg_addr(), ;; creator
        ds~load_coins(),    ;; reward_per_completion
        ds~load_coins(),    ;; reward_pool
        ds~load_uint(1),    ;; is_open
        ds~load_uint(8),    ;; question_count (0 = not initialised yet)
        ds~load_uint(32),   ;; response_count
        ds~load_dict(),     ;; questions
        ds~load_dict(),     ;; answered
        ds~load_dict()      ;; responses
    );
}

;; -----------------------------------------
;; ANSWER VALIDATION
;; -----------------------------------------

;; Adds one vote to every selected option. Returns the new votes cell
;; and how many options were selected.
(cell, int) add_votes(cell votes, int mask) inline {
    slice s = votes.begin_parse();
    builder b = begin_cell();
    int selected = 0;
    repeat (max_options) {
        int v = s~load_uint(32);
        if (mask & 1) {
            v += 1;
            selected += 1;
        }
        mask = mask >> 1;
        b = b.store_uint(v, 32);
    }
    return (b.end_cell(), selected);
}

;; Text is checked 31 bytes at a time, loaded as one integer (248 bits, so
;; `word << 1` still fits in TVM's 257-bit integers). A byte-by-byte loop costs
;; ~120 gas per byte and a full 10 x 200-emoji submission would hit the 1M gas limit.
const int chunk_bytes = 31;
const int high_bits = 0x80808080808080808080808080808080808080808080808080808080808080; ;; 0x80 in every byte
const int low_bits = 0x01010101010101010101010101010101010101010101010101010101010101;  ;; 0x01 in every byte
const int x60_bits = 0x60606060606060606060606060606060606060606060606060606060606060;  ;; 0x60 in every byte

;; How many characters start in `len` (<= 31) bytes loaded as `word`.
;; A UTF-8 continuation byte looks like 10xxxxxx; every other byte starts a character,
;; so "é" (2 bytes) or an emoji (4 bytes) counts as one character.
int count_char_starts(int word, int len) inline {
    ;; bit 7 set and bit 6 clear -> continuation byte, flagged in bit 7 of that byte
    int flags = word & (~ (word << 1)) & high_bits;
    ;; Move every flag to bit 0 of its byte and multiply by 0x0101..01: byte 30 of the
    ;; product is the sum of all 31 flags (at most 31, so no byte ever carries over).
    int continuations = muldiv(flags >> 7, low_bits, 1 << 240) & 0xFF;
    return len - continuations;
}

;; Are all `len` bytes printable ASCII, 0x20 (space) .. 0x7E (~)?
;; That is letters a-z A-Z, digits, space and normal punctuation . , ! ? ' " - ( ) : ; ...
;; Emoji, accented letters (é), curly quotes, tabs and newlines are all outside it.
;; Every byte of the chunk is checked at once; a "bad" byte gets bit 7 set:
int is_printable_ascii(int word, int len) inline {
    int bad = word                    ;; bit 7 already set: byte >= 0x80 (not ASCII at all)
        | (~ (word + x60_bits))       ;; byte + 0x60 < 0x80: byte < 0x20 (control character)
        | (word + low_bits);          ;; byte + 0x01 >= 0x80: byte = 0x7F (DEL)
    ;; A byte >= 0x80 can carry into its neighbour during the additions, but the
    ;; first line already rejects the chunk then. Only the `len` loaded bytes count.
    return (bad & high_bits & ((1 << (len * 8)) - 1)) == 0;
}

;; Counts the UTF-8 characters of a snake-encoded text answer.
;; Throws if the layout is not a snake string, it is longer than max_bytes,
;; or, when ascii_only is 1, it has a character outside printable ASCII.
int count_chars(cell answer, int max_bytes, int ascii_only) impure inline {
    slice s = answer.begin_parse();
    int chars = 0;
    int bytes = 0;
    int cells = 0;
    int refs = 0;
    do {
        int bits = s.slice_bits();
        refs = s.slice_refs();
        throw_unless(error::bad_text, (bits % 8 == 0) & (refs <= 1));

        int len = bits / 8;
        bytes += len;
        cells += 1;
        throw_unless(error::bad_text, (bytes <= max_bytes) & (cells <= max_bytes / snake_cell_bytes + 1));

        while (len > 0) {
            int n = min(len, chunk_bytes);
            int word = s~load_uint(n * 8);
            chars += count_char_starts(word, n);
            if (ascii_only) {
                throw_unless(error::char_not_allowed, is_printable_ascii(word, n));
            }
            len -= n;
        }
        if (refs) {
            s = s.preload_ref().begin_parse();
        }
    } until (refs == 0);
    return chars;
}

;; Validates every answer and tallies choice votes.
;; Returns the updated questions dict and the answers dict to store.
(cell, cell) apply_answers(cell questions, int question_count, cell answers) impure inline {
    cell stored = new_dict();
    int i = 0;
    repeat (question_count) {
        (cell answer, int has_answer) = answers.udict_get_ref?(8, i);
        throw_unless(error::missing_answer, has_answer);

        (cell q, int found) = questions.udict_get_ref?(8, i);
        throw_unless(error::not_found, found);
        var (qtype, min_count, max_count, ascii_only, text, options, votes) = unpack_question(q);

        if (qtype == qtype::choice) {
            slice s = answer.begin_parse();
            throw_unless(error::bad_choice, (s.slice_bits() == 8) & (s.slice_refs() == 0));
            int mask = s.preload_uint(8);

            int option_count = options.begin_parse().preload_uint(8);
            throw_unless(error::bad_choice, mask < (1 << option_count));

            (cell new_votes, int selected) = add_votes(votes, mask);
            throw_unless(error::bad_choice, (selected >= min_count) & (selected <= max_count));

            questions~udict_set_ref(8, i,
                pack_question(qtype, min_count, max_count, ascii_only, text, options, new_votes));
        } else {
            int chars = count_chars(answer, max_count * max_utf8_bytes, ascii_only);
            throw_unless(error::bad_text, (chars >= min_count) & (chars <= max_count));
        }

        ;; Re-built from validated cells only, so nothing else from the message gets stored
        stored~udict_set_ref(8, i, answer);
        i += 1;
    }
    return (questions, stored);
}

;; -----------------------------------------
;; MESSAGES
;; -----------------------------------------

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }

    slice sender_address = cs~load_msg_addr();
    int op = in_msg_body~load_uint(32);

    var (master, survey_id, creator, reward, pool, is_open,
         question_count, response_count, questions, answered, responses) = load_data();

    ;; Initialise from the master (only once, right after deploy)
    ;; Body: creator reward:coins pool:coins question_count:uint8 ^questions
    if (op == op::init_survey) {
        throw_unless(error::not_allowed, equal_slices(sender_address, master) & (question_count == 0));

        creator = in_msg_body~load_msg_addr();
        reward = in_msg_body~load_coins();
        pool = in_msg_body~load_coins();
        question_count = in_msg_body~load_uint(8);
        questions = in_msg_body~load_ref();

        set_data(pack_survey_data(master, survey_id, creator, reward, pool, 1,
                                  question_count, response_count, questions, answered, responses));
        return ();
    }

    ;; Submit one answer for every question. Pays reward_per_completion once.
    ;; Body: ^answers (HashmapE 8 ^Answer)
    if (op == op::submit) {
        throw_unless(error::not_enough_ton, msg_value >= min_submit_value);
        throw_unless(error::closed, is_open);

        int key = slice_hash(sender_address);
        (_, int done) = answered.udict_get?(256, key);
        throw_if(error::already_answered, done);

        (cell new_questions, cell stored) = apply_answers(questions, question_count, in_msg_body~load_ref());
        questions = new_questions;

        answered~udict_set_builder(256, key, begin_cell().store_uint(response_count, 32));
        responses~udict_set_ref(32, response_count, begin_cell()
            .store_slice(sender_address)
            .store_ref(stored)
            .end_cell());
        response_count += 1;

        pool -= reward;

        ;; Close automatically once the pool can't pay another completion
        int leftover = 0;
        if ((reward > 0) & (pool < reward)) {
            is_open = 0;
            leftover = pool;
            pool = 0;
        }

        set_data(pack_survey_data(master, survey_id, creator, reward, pool, is_open,
                                  question_count, response_count, questions, answered, responses));

        if (leftover > 0) {
            send_ton(creator, leftover, 1);
        }

        ;; Stored answers cost storage fees for as long as the contract lives, so keep
        ;; storage_deposit from this message. Everything else (reward + the unused part
        ;; of msg_value) goes back to the respondent.
        raw_reserve(my_balance - msg_value - reward - leftover + storage_deposit, 0);
        send_ton(sender_address, 0, 128);
        return ();
    }

    ;; Creator closes the survey and gets the remaining pool back.
    ;; Storage deposits stay so the stored responses remain readable.
    if (op == op::close_survey) {
        throw_unless(error::not_allowed, equal_slices(sender_address, creator));
        throw_unless(error::closed, is_open);

        set_data(pack_survey_data(master, survey_id, creator, reward, 0, 0,
                                  question_count, response_count, questions, answered, responses));

        send_ton(sender_address, pool, 64);
        return ();
    }

    throw(0xffff);
}

;; -----------------------------------------
;; GETTERS
;; -----------------------------------------

;; Returns master, survey_id, creator, reward, pool, is_open, question_count, response_count
(slice, int, slice, int, int, int, int, int) get_survey_info() method_id {
    var (master, survey_id, creator, reward, pool, is_open, question_count, response_count, _, _, _) = load_data();
    return (master, survey_id, creator, reward, pool, is_open, question_count, response_count);
}

;; Returns qtype, min_count, max_count, ascii_only, text, options, votes for one question.
;; options and votes are null for text questions.
(int, int, int, int, cell, cell, cell) get_question(int question_index) method_id {
    var (_, _, _, _, _, _, question_count, _, questions, _, _) = load_data();
    throw_unless(error::bad_survey, question_index < question_count);

    (cell q, int found) = questions.udict_get_ref?(8, question_index);
    throw_unless(error::not_found, found);
    return unpack_question(q);
}

;; Returns respondent and answers (HashmapE 8 ^Answer) of one response.
(slice, cell) get_response(int response_index) method_id {
    var (_, _, _, _, _, _, _, _, _, _, responses) = load_data();
    (cell r, int found) = responses.udict_get_ref?(32, response_index);
    throw_unless(error::not_found, found);

    slice rs = r.begin_parse();
    return (rs~load_msg_addr(), rs~load_ref());
}

;; Index of this respondent's response, or -1 if they have not answered.
int get_response_index(slice respondent) method_id {
    var (_, _, _, _, _, _, _, _, _, answered, _) = load_data();
    (slice v, int done) = answered.udict_get?(256, slice_hash(respondent));
    if (done) {
        return v.preload_uint(32);
    }
    return -1;
}

int has_answered(slice respondent) method_id {
    var (_, _, _, _, _, _, _, _, _, answered, _) = load_data();
    (_, int done) = answered.udict_get?(256, slice_hash(respondent));
    return done;
}
